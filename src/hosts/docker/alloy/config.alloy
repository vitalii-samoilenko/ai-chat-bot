livedebugging {
  enabled = true
}

otelcol.receiver.otlp "service" {
  grpc {
    endpoint = "0.0.0.0:8081"
  }

  output {
    metrics = [otelcol.processor.batch.aggregator.input]
    logs    = [otelcol.processor.batch.aggregator.input]
    traces  = [otelcol.processor.batch.aggregator.input]
  }
}

otelcol.processor.batch "aggregator" {
  output {
    metrics = [otelcol.exporter.otlphttp.prometheus.input]
    logs    = [otelcol.exporter.otlphttp.loki.input]
    traces  = [otelcol.exporter.otlphttp.tempo.input]
  }
}


otelcol.exporter.otlphttp "prometheus" {
  client {
    endpoint = "http://prometheus:8080/api/v1/otlp"
    tls {
      insecure = true
    }
  }
}
otelcol.exporter.otlphttp "loki" {
  client {
    endpoint = "http://loki:8080/otlp"
    tls {
      insecure = true
    }
  }
}
otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "http://tempo:8082"
    tls {
      insecure = true
    }
  }
}
